        "import re\n",
        "import time\n",
        "from datetime import timedelta\n",
        "\n",
        "def date_windows(start, end, window_days=1):\n",
        "    cur = start\n",
        "    while cur <= end:\n",
        "        chunk_end = min(cur + timedelta(days=window_days - 1), end)\n",
        "        yield cur, chunk_end\n",
        "        cur = chunk_end + timedelta(days=1)\n",
        "\n",
        "def _flatten_payload(payload_data):\n",
        "    rows = []\n",
        "    for item in payload_data:\n",
        "        docs = item.get(\"documents\")\n",
        "        if isinstance(docs, list) and docs:\n",
        "            for doc in docs:\n",
        "                rows.append({\n",
        "                    \"report_id\": doc.get(\"report_id\"),\n",
        "                    \"event_id\": doc.get(\"event_id\") or item.get(\"event_id\"),\n",
        "                    \"primary_id\": (doc.get(\"primary_ids\") or [None])[0],\n",
        "                    \"story_date_time\": doc.get(\"story_date_time\") or item.get(\"story_date_time\"),\n",
        "                    \"headline\": doc.get(\"headline\") or item.get(\"headline\"),\n",
        "                    \"transcripts_url\": doc.get(\"transcripts_url\"),\n",
        "                })\n",
        "        else:\n",
        "            rows.append({\n",
        "                \"report_id\": item.get(\"report_id\"),\n",
        "                \"event_id\": item.get(\"event_id\"),\n",
        "                \"primary_id\": (item.get(\"primary_ids\") or [None])[0],\n",
        "                \"story_date_time\": item.get(\"story_date_time\"),\n",
        "                \"headline\": item.get(\"headline\"),\n",
        "                \"transcripts_url\": item.get(\"transcripts_url\"),\n",
        "            })\n",
        "    return rows\n",
        "\n",
        "def search_transcripts_by_date(api, start, end, page_limit=200, throttle=0.15, time_zone=\"America/New_York\", max_retries=5):\n",
        "    rows, offset = [], 0\n",
        "    while True:\n",
        "        req = TranscriptsRequest(\n",
        "            data=TranscriptsByDateRequest(start_date=start, end_date=end, time_zone=time_zone),\n",
        "            meta=TranscriptsRequestMeta(\n",
        "                pagination=TranscriptsRequestMetaPagination(limit=page_limit, offset=offset),\n",
        "                sort=[\"-storyDateTime\"],\n",
        "            ),\n",
        "        )\n",
        "        resp = None\n",
        "        for attempt in range(max_retries):\n",
        "            try:\n",
        "                resp = api.search_transcripts(req)\n",
        "                break\n",
        "            except Exception as exc:\n",
        "                is_429 = \"(429)\" in str(exc) or \"Too Many Requests\" in str(exc)\n",
        "                if is_429 and attempt < max_retries - 1:\n",
        "                    wait = 2 ** attempt  # 1s, 2s, 4s, 8s, ...\n",
        "                    print(f\"  [WARN] 429 rate limited for {start}-{end}; retrying in {wait}s (attempt {attempt + 1}/{max_retries})...\")\n",
        "                    time.sleep(wait)\n",
        "                    continue\n",
        "                print(f\"  [WARN] API error for {start}-{end}: {exc!s:.150}; skipping window.\")\n",
        "                break\n",
        "        if resp is None:\n",
        "            break\n",
        "\n",
        "        batch = _flatten_payload(resp.to_dict().get(\"data\", []))\n",
        "        if not batch:\n",
        "            break\n",
        "        rows.extend(batch)\n",
        "        if len(batch) < page_limit:\n",
        "            break\n",
        "        offset += page_limit\n",
        "        time.sleep(throttle)\n",
        "    return rows\n",
        "\n",
        "print(\"Search helpers defined.\")"
