        "import io\n",
        "import html\n",
        "import re # Added missing import\n",
        "from fpdf import FPDF\n",
        "\n",
        "def headline_to_filename(headline, primary_id):\n",
        "    # Basic sanitization for filenames\n",
        "    safe_headline = re.sub(r'[^a-zA-Z0-9_ -]', '', headline.replace('/', '-'))\n",
        "    return f\"{primary_id.split('-')[0]} - {safe_headline}.pdf\"\n",
        "\n",
        "def xml_bytes_to_pdf(xml_bytes, title):\n",
        "    pdf = FPDF()\n",
        "    pdf.add_page()\n",
        "    pdf.set_font(\"Arial\", size=12)\n",
        "\n",
        "    # Decode XML to string, unescape HTML entities, and split into lines\n",
        "    text_content = html.unescape(xml_bytes.decode('utf-8'))\n",
        "    lines = text_content.split('\\n')\n",
        "\n",
        "    for line in lines:\n",
        "        # Simple heuristic to identify potential section headers or important lines\n",
        "        if len(line) < 80 and any(char.isupper() for char in line) and not line.isspace():\n",
        "            pdf.set_font(\"Arial\", \"B\", size=14)\n",
        "            pdf.multi_cell(0, 10, line.strip())\n",
        "            pdf.ln(2) # Add some space after a potential header\n",
        "            pdf.set_font(\"Arial\", size=12)\n",
        "        else:\n",
        "            pdf.multi_cell(0, 10, line.strip())\n",
        "            pdf.ln(1) # Smaller line break for regular text\n",
        "\n",
        "    buffer = io.BytesIO()\n",
        "    pdf.output(buffer)\n",
        "    return buffer.getvalue()\n",
        "\n",
        "print(\"XML to PDF conversion helpers defined.\")"
