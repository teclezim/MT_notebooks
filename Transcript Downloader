        "    try:\n",
        "        token = fds_client_obj.get_access_token()\n",
        "        headers = {\"Authorization\": f\"Bearer {token}\", \"Accept\": \"application/xml\"}\n",
        "        resp = requests.get(\n",
        "            f\"{_API_BASE}/transcripts/response-type\",\n",
        "            headers=headers,\n",
        "            params={\"reportIds\": report_id, \"format\": \"ContentXML\"},\n",
        "            timeout=timeout,\n",
        "        )\n",
        "        resp.raise_for_status()\n",
        "        content = resp.content\n",
        "        sniff = content[:100].lstrip().lower()\n",
        "        if sniff.startswith((b\"<!doctype\", b\"<html\")):\n",
        "            return None\n",
        "        return content\n",
        "    except Exception:\n",
